SECRET_KEY=django-insecure-replace-with-50-char-random-string
DEBUG=True
DB_NAME=oficios_db
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_YOUR_PG_PASSWORD
DB_HOST=localhost
DB_PORT=5432
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
# Instalar OSGeo4W (https://trac.osgeo.org/osgeo4w/) y ajustar el nombre del .dll
GDAL_LIBRARY_PATH=C:\OSGeo4W\bin\gdal310.dll
GEOS_LIBRARY_PATH=C:\OSGeo4W\bin\geos_c.dll
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
